# OpenRouter API Credentials
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=openrouter/free

# Firecrawl API Credentials (Used for Web Search & Web Scraping in Plan/Ask modes)
# Get your API key at: https://www.firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Telegram Bot Credentials (Optional - only required for Telegram Bot Mode)
# Create a bot via @BotFather on Telegram to get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your numeric Telegram User ID (Get it from @userinfobot on Telegram)
TELEGRAM_OWNER_ID=your_telegram_user_id_here
